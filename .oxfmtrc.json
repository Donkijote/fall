{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css"
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "public/**",
    "src/assets/**",
    "pnpm-lock.yaml"
  ],
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": {
    "order": "asc",
    "newlinesBetween": true,
    "sortSideEffects": false,
    "customGroups": [
      {
        "groupName": "react-scope",
        "elementNamePattern": ["@react/**"]
      },
      {
        "groupName": "app-alias",
        "elementNamePattern": ["@/**"]
      },
      {
        "groupName": "scoped-packages",
        "elementNamePattern": ["@*/**"]
      }
    ],
    "groups": [
      ["builtin", "external"],
      "react-scope",
      "app-alias",
      "scoped-packages",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
