    "credits:notices": "node scripts/credits-notices.mjs",
    "credits:notices:check": "node scripts/credits-notices.mjs --check",
    "dev": "vp dev --host",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:preview": "pnpm run build && wrangler preview",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "preview:cloudflare": "wrangler dev",
    "preview": "vp preview",
    "desktop": "tauri dev",
    "ios": "tauri ios dev",
    "test": "vp test",
    "test:coverage": "vp test run --coverage"
  },
