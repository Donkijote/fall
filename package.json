{
  "name": "fall",
  "private": true,
  "version": "0.0.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "bun install --frozen-lockfile && bun run build && wrangler pages deploy dist",
    "preview": "vite preview",
    "lint": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.65.0"
  },
  "dependencies": {
    "pixi.js": "^8.16.0"
  }
}
