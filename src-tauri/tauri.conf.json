{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "The Fall",
  "version": "../package.json",
  "identifier": "com.donkijote.the-fall",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev --no-open",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "The Fall",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "17.0",
      "bundleVersion": "1"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "1"
    },
    "copyright": "Copyright (c) 2025\u20132026 Donkijote. All rights reserved."
  }
}
